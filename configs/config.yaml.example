## REQUIRED KEYS
model: "nemotron-3-nano:30b" # cloud or local model name, key required

spec_prompt: "prompt/spec.txt" # key required

spec_path: "workspace/ASSISTANT.md"  # key required

profiles_dir: "profiles" # key required, relative to this file's directory

default_profile: "wu" # key required, name of a file in profiles_dir (without .yaml)

file_access_config: "file_access.yaml" # optional permissions file, relative to configs/
ollama_provider: auto # optional: auto, local, or cloud
think: true # optional: enable model reasoning for chat replies

## OPTIONAL KEYS
