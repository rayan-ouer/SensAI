## SensAI configuration example
## Copy this file and run: wu -c path/to/your_config.yaml
## Paths are relative to this file's directory, except spec_path (relative to where you run wu).

## REQUIRED KEYS

# string: model name, local (see `ollama list`) or Ollama Cloud (needs OLLAMA_API_KEY in .env)
model: "qwen2.5-coder:7b"

# string: path to the general system prompt, a text file
system_prompt: "prompt/versions/v2/system.txt"

# string: path to the prompt of the note-keeper that updates the specification, a text file
spec_prompt: "prompt/versions/v2/spec.txt"

# string: path to what the clarification tool tells the agent once the web interface shows its question, a text file
question_prompt: "prompt/versions/v2/question.txt"

# string: path of the living specification, a Markdown file created if missing
spec_path: "workspace/ASSISTANT.md"

# string: directory containing the agent profiles (*.yaml files)
profiles_dir: "profiles"

# string: profile active at start, a file name in profiles_dir without .yaml
default_profile: "wu"

## OPTIONAL KEYS

# bool: model reasoning during spec updates, false is faster but less careful (default: model's choice)
spec_think: false

# int: maximum number of agent steps (model calls and tool calls) for one message (default: 10)
max_loops: 10

# dict: options passed to the model (default: {})
# temperature (float, 0 = always the same answer), top_k (int), top_p (float), num_ctx (int), seed (int)
llm_settings: {temperature: 0.2, top_k: 50}

# bool: model reasoning for chat replies (default: model's choice)
think: true

# string: where to find the model, auto (local then cloud), local or cloud (default: auto)
ollama_provider: auto

# string: permissions file of the workspace file tools, relative to this file's directory (default: file_access.yaml)
file_access_config: "file_access.yaml"

# dict: JSON schema the replies must follow (default: free text)
# response_format: {type: object, properties: {answer: {type: string}}, required: [answer]}
